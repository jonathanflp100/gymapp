# Copie para .env e ajuste. NUNCA envie o .env para o GitHub.

# Endereço do app (com https quando tiver domínio) e o domínio sozinho
ORIGIN=http://localhost:8080
RP_ID=localhost

# Código que ativa o administrador da academia (troque por um seu, difícil de adivinhar)
SETUP_CODE=troque-este-codigo

# Marca inicial (depois o administrador muda tudo pela tela de configurações)
GYM_NAME=Minha Academia
GYM_COLOR=#DC2626
# pt-BR (Brasil) ou es-PY (Paraguai)
GYM_LANG=pt-BR
GYM_CODE=ACADEMIA

# Fuso horário: America/Sao_Paulo ou America/Asuncion
TZ=America/Sao_Paulo
WEB_PORT=8080
